# Copy to .env and fill only the credentials/endpoints you use.
# Choose normal provider/model defaults with the Web Settings page or:
#   autoidea config set provider openai
#   autoidea config set model gpt-5.6-sol
OPENAI_API_KEY=

# Alternative hosted providers
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional search credentials. Academic search still has keyless sources.
TAVILY_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=

# Optional OpenAI-compatible endpoint
CUSTOM_OPENAI_API_KEY=
CUSTOM_OPENAI_BASE_URL=

# Optional Anthropic-compatible endpoint
CUSTOM_ANTHROPIC_API_KEY=
CUSTOM_ANTHROPIC_BASE_URL=

# Optional local Ollama endpoint
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Optional deployment-wide locks. Most local users should leave these unset;
# they override values saved through Web Settings or `autoidea config set`.
# AUTOIDEA_PROVIDER=openai
# AUTOIDEA_MODEL=gpt-5.6-sol
# AUTOIDEA_AUTO_APPROVE=true
